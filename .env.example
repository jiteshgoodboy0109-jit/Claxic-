# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Database connection string
DATABASE_URL="file:./data/claxic.db"

# AUTH_SECRET: Secure secret for signing session tokens and verification hashes
AUTH_SECRET="claxic_production_auth_secret_key_change_in_prod"

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: Google OAuth credentials for Google Login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Razorpay Payment Gateway credentials
RAZORPAY_KEY_ID="rzp_test_claxic92837482"
RAZORPAY_KEY_SECRET="rzp_sec_claxic92837482secret"

# EMAIL SERVER & CREDENTIALS
